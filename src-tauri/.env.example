# Copy to src-tauri/.env (never commit .env). Only needed for the native layer:
# tray events, quick-add and notifications. The calendar window works without it.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Google requires the secret for "Desktop app" clients even with PKCE.
# For installed apps it is not treated as confidential.
GOOGLE_CLIENT_SECRET=
