{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calshell",
  "version": "0.1.1",
  "identifier": "calshell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Calshell contributors",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Google Calendar as a real Windows app",
    "longDescription": "Google Calendar in a native window with a tray, a global quick-add hotkey, native reminders and launch on login.",
    "homepage": "https://github.com/Snesseye/calshell",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
